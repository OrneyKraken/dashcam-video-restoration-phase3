# Dataset frames - 262 GB, never commit. See README for how to obtain.
dataset/
# A leftover local copy of the portable eval package (dataset + a second core
# checkout) - never commit; the repo IS the core, and dataset/ above already
# covers the frames.
/dashmamba_package/
*.png
*.jpg
*.mp4

# Third-party model code is NOT vendored here - each has its own licence
# (RVRT is CC-BY-NC, mmagic Apache-2.0, FastDVDnet its own terms). The README
# explains how to clone them and which patches this project applied.
external/

# Training/eval logs and scratch output
logs/
# Checkpoints are committed under checkpoints/ instead of runs/.
runs/*/
!checkpoints/
*.tmp
.build/

# Python
__pycache__/
*.py[cod]
.ipynb_checkpoints/
venv/
.venv/

# Committed qualitative figures are an explicit exception to the *.png rule
# above - figures/**/*.png covers both figures/*.png and any subfolder
# (figures/track_c/, figures/davis/, ...), which a bare figures/*.png misses.
!figures/
!figures/**/*.png
